{
  "info": {
    "name": "ECommerce API",
    "description": "ECommerce backend API. Base URL: http://localhost:3000/api (PORT env). Swagger docs at /api/swagger.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "access_token",
      "value": ""
    },
    {
      "key": "refresh_token",
      "value": ""
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/v1/auth/register", "host": ["{{base_url}}"], "path": ["v1", "auth", "register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"fullname\": \"John Doe\",\n  \"password\": \"StrongPass1!\",\n  \"phoneNumber\": \"+201001234567\"\n}"
            },
            "description": "Public. Password must be >= 8 chars with upper, lower, number, symbol. phoneNumber must be Egyptian format."
          }
        },
        {
          "name": "Login",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/v1/auth/login", "host": ["{{base_url}}"], "path": ["v1", "auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"StrongPass1!\"\n}"
            },
            "description": "Returns access + refresh tokens. Copy tokens into collection variables."
          }
        },
        {
          "name": "Verify Email",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/v1/auth/email/verify", "host": ["{{base_url}}"], "path": ["v1", "auth", "email", "verify"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"<verification-token>\"\n}"
            }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/v1/auth/token/refresh", "host": ["{{base_url}}"], "path": ["v1", "auth", "token", "refresh"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refresh_token}}\"\n}"
            }
          }
        },
        {
          "name": "Revoke Token",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/v1/auth/token/revoke", "host": ["{{base_url}}"], "path": ["v1", "auth", "token", "revoke"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refresh_token}}\"\n}"
            }
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/v1/auth/password/forgot", "host": ["{{base_url}}"], "path": ["v1", "auth", "password", "forgot"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\"\n}"
            }
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/v1/auth/password/reset", "host": ["{{base_url}}"], "path": ["v1", "auth", "password", "reset"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"<reset-token>\",\n  \"password\": \"NewPass123!\"\n}"
            }
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/v1/auth/me", "host": ["{{base_url}}"], "path": ["v1", "auth", "me"] },
            "description": "Requires Bearer token."
          }
        }
      ]
    },
    {
      "name": "Categories",
      "item": [
        {
          "name": "Create Category (admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/categories", "host": ["{{base_url}}"], "path": ["categories"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Electronics\",\n  \"description\": \"Electronic devices and accessories\",\n  \"slug\": \"electronics\"\n}"
            }
          }
        },
        {
          "name": "List Categories",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/categories?search=&sortBy=name&sortOrder=ASC&page=1&limit=10",
              "host": ["{{base_url}}"],
              "path": ["categories"],
              "query": [
                { "key": "search", "value": "" },
                { "key": "sortBy", "value": "name", "description": "name | createdAt | updatedAt" },
                { "key": "sortOrder", "value": "ASC", "description": "ASC | DESC" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Get Category",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/categories/:id", "host": ["{{base_url}}"], "path": ["categories", ":id"] }
          }
        },
        {
          "name": "Update Category (admin)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/categories/:id", "host": ["{{base_url}}"], "path": ["categories", ":id"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Electronics\",\n  \"description\": \"Updated description\",\n  \"slug\": \"electronics\"\n}"
            }
          }
        },
        {
          "name": "Delete Category (admin)",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{base_url}}/categories/:id", "host": ["{{base_url}}"], "path": ["categories", ":id"] }
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "List Users (admin)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/users?search=&role=user&isActive=true&sortBy=createdAt&sortOrder=DESC&page=1&limit=10",
              "host": ["{{base_url}}"],
              "path": ["users"],
              "query": [
                { "key": "search", "value": "", "description": "Search by fullname" },
                { "key": "role", "value": "user", "description": "user | staff | admin" },
                { "key": "isActive", "value": "true" },
                { "key": "sortBy", "value": "createdAt", "description": "fullname | email | role | isActive | createdAt | updatedAt" },
                { "key": "sortOrder", "value": "DESC" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            },
            "description": "Requires admin/staff permission."
          }
        },
        {
          "name": "Get User",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/users/:id", "host": ["{{base_url}}"], "path": ["users", ":id"] }
          }
        },
        {
          "name": "Update User",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/users/:id", "host": ["{{base_url}}"], "path": ["users", ":id"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullname\": \"Jane Doe\",\n  \"phoneNumber\": \"+201001234567\"\n}"
            }
          }
        },
        {
          "name": "Deactivate User",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{base_url}}/users/:id", "host": ["{{base_url}}"], "path": ["users", ":id"] }
          }
        },
        {
          "name": "Activate User (admin)",
          "request": {
            "method": "PATCH",
            "url": { "raw": "{{base_url}}/users/:id/activate", "host": ["{{base_url}}"], "path": ["users", ":id", "activate"] }
          }
        },
        {
          "name": "Change Role (admin)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/users/:id/change-role", "host": ["{{base_url}}"], "path": ["users", ":id", "change-role"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"staff\"\n}"
            },
            "description": "role: user | staff | admin"
          }
        }
      ]
    }
  ]
}
