{
  "info": {
    "name": "ECommerce API",
    "description": "ECommerce backend API. Base URL: http://localhost:3000/api (PORT env). Swagger docs at /api/swagger.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "access_token",
      "value": ""
    },
    {
      "key": "refresh_token",
      "value": ""
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/v1/auth/register", "host": ["{{base_url}}"], "path": ["v1", "auth", "register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"fullname\": \"John Doe\",\n  \"password\": \"StrongPass1!\",\n  \"phoneNumber\": \"+201001234567\"\n}"
            },
            "description": "Public. Password must be >= 8 chars with upper, lower, number, symbol. phoneNumber must be Egyptian format."
          }
        },
        {
          "name": "Login",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/v1/auth/login", "host": ["{{base_url}}"], "path": ["v1", "auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"StrongPass1!\"\n}"
            },
            "event": [
              {
                "listen": "test",
                "script": {
                  "type": "text/javascript",
                  "exec": [
                    "const body = pm.response.json();",
                    "",
                    "pm.test('Login returns tokens', function () {",
                    "    pm.expect(body.tokens && body.tokens.accessToken).to.be.a('string');",
                    "    pm.expect(body.tokens && body.tokens.refreshToken).to.be.a('string');",
                    "});",
                    "",
                    "if (body.tokens) {",
                    "    pm.collectionVariables.set('access_token', body.tokens.accessToken);",
                    "    pm.collectionVariables.set('refresh_token', body.tokens.refreshToken);",
                    "}"
                  ]
                }
              }
            ],
            "description": "Returns access + refresh tokens and saves them to collection variables."
          }
        },
        {
          "name": "Verify Email",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/v1/auth/email/verify", "host": ["{{base_url}}"], "path": ["v1", "auth", "email", "verify"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"<verification-token>\"\n}"
            }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/v1/auth/token/refresh", "host": ["{{base_url}}"], "path": ["v1", "auth", "token", "refresh"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refresh_token}}\"\n}"
            },
            "event": [
              {
                "listen": "test",
                "script": {
                  "type": "text/javascript",
                  "exec": [
                    "const body = pm.response.json();",
                    "",
                    "pm.test('Refresh returns tokens', function () {",
                    "    pm.expect(body.accessToken).to.be.a('string');",
                    "    pm.expect(body.refreshToken).to.be.a('string');",
                    "});",
                    "",
                    "if (body.accessToken) {",
                    "    pm.collectionVariables.set('access_token', body.accessToken);",
                    "}",
                    "if (body.refreshToken) {",
                    "    pm.collectionVariables.set('refresh_token', body.refreshToken);",
                    "}"
                  ]
                }
              }
            ],
            "description": "Exchanges the refresh token for a new access + refresh token pair and saves them to collection variables."
          }
        },
        {
          "name": "Revoke Token",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/v1/auth/token/revoke", "host": ["{{base_url}}"], "path": ["v1", "auth", "token", "revoke"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refresh_token}}\"\n}"
            }
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/v1/auth/password/forgot", "host": ["{{base_url}}"], "path": ["v1", "auth", "password", "forgot"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\"\n}"
            }
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/v1/auth/password/reset", "host": ["{{base_url}}"], "path": ["v1", "auth", "password", "reset"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"<reset-token>\",\n  \"password\": \"NewPass123!\"\n}"
            }
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/v1/auth/me", "host": ["{{base_url}}"], "path": ["v1", "auth", "me"] },
            "description": "Requires Bearer token."
          }
        }
      ]
    },
    {
      "name": "Categories",
      "item": [
        {
          "name": "Create Category (staff/admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/categories", "host": ["{{base_url}}"], "path": ["categories"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Electronics\",\n  \"description\": \"Electronic devices and accessories\",\n  \"slug\": \"electronics\"\n}"
            }
          }
        },
        {
          "name": "List Categories",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/categories?search=&sortBy=name&sortOrder=ASC&page=1&limit=10",
              "host": ["{{base_url}}"],
              "path": ["categories"],
              "query": [
                { "key": "search", "value": "" },
                { "key": "sortBy", "value": "name", "description": "name | createdAt | updatedAt" },
                { "key": "sortOrder", "value": "ASC", "description": "ASC | DESC" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Get Category By Slug",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "{{base_url}}/categories/slug/:slug", "host": ["{{base_url}}"], "path": ["categories", "slug", ":slug"] },
            "description": "Public. Returns the category matching the slug."
          }
        },
        {
          "name": "Get Category",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "{{base_url}}/categories/:id", "host": ["{{base_url}}"], "path": ["categories", ":id"] }
          }
        },
        {
          "name": "Update Category (staff/admin)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/categories/:id", "host": ["{{base_url}}"], "path": ["categories", ":id"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Electronics\",\n  \"description\": \"Updated description\",\n  \"slug\": \"electronics\"\n}"
            }
          }
        },
        {
          "name": "Delete Category (admin)",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{base_url}}/categories/:id", "host": ["{{base_url}}"], "path": ["categories", ":id"] }
          }
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "Create Product (staff/admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/products", "host": ["{{base_url}}"], "path": ["products"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Wireless Mouse\",\n  \"slug\": \"wireless-mouse\",\n  \"description\": \"Ergonomic wireless mouse with USB receiver\",\n  \"price\": 29.99,\n  \"stock\": 100,\n  \"categoryId\": \"<category-id>\"\n}"
            },
            "description": "Requires staff/admin permission. name 3-255 chars, description 3-1000, price >= 0, stock integer >= 0."
          }
        },
        {
          "name": "List Products",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/products?sortBy=name&sortOrder=ASC&page=1&limit=10",
              "host": ["{{base_url}}"],
              "path": ["products"],
              "query": [
                { "key": "sortBy", "value": "name", "description": "name | price | rating | reviewCount | stock | createdAt | updatedAt" },
                { "key": "sortOrder", "value": "ASC", "description": "ASC | DESC" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10", "description": "1-100" }
              ]
            },
            "description": "Public. Optional filters: search (name contains), categoryId (UUID)."
          }
        },
        {
          "name": "Get Product By Slug",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "{{base_url}}/products/slug/:slug", "host": ["{{base_url}}"], "path": ["products", "slug", ":slug"] },
            "description": "Public. Returns the product matching the slug."
          }
        },
        {
          "name": "Get Product",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "{{base_url}}/products/:id", "host": ["{{base_url}}"], "path": ["products", ":id"] }
          }
        },
        {
          "name": "Update Product (staff/admin)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/products/:id", "host": ["{{base_url}}"], "path": ["products", ":id"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Wireless Mouse Pro\",\n  \"price\": 34.99,\n  \"stock\": 80\n}"
            },
            "description": "All fields optional."
          }
        },
        {
          "name": "Delete Product (admin)",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{base_url}}/products/:id", "host": ["{{base_url}}"], "path": ["products", ":id"] }
          }
        }
      ]
    },
    {
      "name": "Cart",
      "item": [
        {
          "name": "Get My Cart",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/cart", "host": ["{{base_url}}"], "path": ["cart"] },
            "description": "Requires Bearer token. Returns the current user's cart, creating an empty cart if needed."
          }
        },
        {
          "name": "Add To Cart",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/cart", "host": ["{{base_url}}"], "path": ["cart"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"<product-id>\"\n}"
            },
            "description": "Requires Bearer token. Adds one unit of the product, or increments the quantity if it is already in the cart. productId must be a UUID."
          }
        },
        {
          "name": "Update Cart Item",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/cart", "host": ["{{base_url}}"], "path": ["cart"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"itemId\": \"<cart-item-id>\",\n  \"quantity\": 2\n}"
            },
            "description": "Requires Bearer token. itemId is the cart item UUID, not the product ID. quantity must be >= 1 and <= product stock."
          }
        },
        {
          "name": "Remove Cart Item",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{base_url}}/cart/:itemId", "host": ["{{base_url}}"], "path": ["cart", ":itemId"] },
            "description": "Requires Bearer token. itemId is the cart item UUID, not the product ID."
          }
        },
        {
          "name": "Clear Cart",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{base_url}}/cart", "host": ["{{base_url}}"], "path": ["cart"] },
            "description": "Requires Bearer token. Removes all items from the current user's cart. Returns 400 if the cart is already empty."
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "List Users (admin)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/users?search=&role=user&isActive=true&sortBy=createdAt&sortOrder=DESC&page=1&limit=10",
              "host": ["{{base_url}}"],
              "path": ["users"],
              "query": [
                { "key": "search", "value": "", "description": "Search by fullname" },
                { "key": "role", "value": "user", "description": "user | staff | admin" },
                { "key": "isActive", "value": "true" },
                { "key": "sortBy", "value": "createdAt", "description": "fullname | email | role | isActive | createdAt | updatedAt" },
                { "key": "sortOrder", "value": "DESC" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            },
            "description": "Requires admin/staff permission."
          }
        },
        {
          "name": "Get User",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/users/:id", "host": ["{{base_url}}"], "path": ["users", ":id"] }
          }
        },
        {
          "name": "Update User",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/users/:id", "host": ["{{base_url}}"], "path": ["users", ":id"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullname\": \"Jane Doe\",\n  \"phoneNumber\": \"+201001234567\"\n}"
            }
          }
        },
        {
          "name": "Deactivate User",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{base_url}}/users/:id", "host": ["{{base_url}}"], "path": ["users", ":id"] }
          }
        },
        {
          "name": "Activate User (admin)",
          "request": {
            "method": "PATCH",
            "url": { "raw": "{{base_url}}/users/:id/activate", "host": ["{{base_url}}"], "path": ["users", ":id", "activate"] }
          }
        },
        {
          "name": "Change Role (admin)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/users/:id/change-role", "host": ["{{base_url}}"], "path": ["users", ":id", "change-role"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"staff\"\n}"
            },
            "description": "role: user | staff | admin"
          }
        }
      ]
    },
    {
      "name": "Reviews",
      "item": [
        {
          "name": "Create Review",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/reviews", "host": ["{{base_url}}"], "path": ["reviews"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rating\": 5,\n  \"comment\": \"This is a great product!\",\n  \"productId\": \"<product-id>\"\n}"
            },
            "description": "Requires Bearer token. rating 1-5, comment 1-1000 chars. One review per user per product (409 on duplicate)."
          }
        },
        {
          "name": "List Reviews",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/reviews?sortBy=createdAt&sortOrder=DESC&page=1&limit=10",
              "host": ["{{base_url}}"],
              "path": ["reviews"],
              "query": [
                { "key": "sortBy", "value": "createdAt", "description": "rating | createdAt | updatedAt" },
                { "key": "sortOrder", "value": "DESC", "description": "ASC | DESC" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10", "description": "1-100" }
              ]
            },
            "description": "Public. Optional filters: productId (UUID), userId (UUID)."
          }
        },
        {
          "name": "Get Review",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "{{base_url}}/reviews/:id", "host": ["{{base_url}}"], "path": ["reviews", ":id"] }
          }
        },
        {
          "name": "Update Review",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/reviews/:id", "host": ["{{base_url}}"], "path": ["reviews", ":id"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rating\": 4,\n  \"comment\": \"Updated comment\"\n}"
            },
            "description": "Requires Bearer token. Only the review author or staff/admin can update. All fields optional."
          }
        },
        {
          "name": "Delete Review",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{base_url}}/reviews/:id", "host": ["{{base_url}}"], "path": ["reviews", ":id"] },
            "description": "Requires Bearer token. Only the review author or staff/admin can delete."
          }
        }
      ]
    }
  ]
}
